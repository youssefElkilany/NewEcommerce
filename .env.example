# Database
# Use your MongoDB Atlas connection string on Vercel.
DB_ATLAS=mongodb://127.0.0.1:27017/ecommerce

# Password hashing and JWT
SALT_ROUND=10
TOKEN_SIGNATURE=replace-with-a-long-random-secret
expireTime=86400
BEARER_KEY="Bearer "

# Application
MOOD=development
App=ecommerce
APP=ecommerce

# Gmail (use an app password, not your normal account password)
gmail=your-email@gmail.com
gmailPass=your-gmail-app-password

# Cloudinary
cloud_name=your-cloud-name
api_key=your-cloudinary-api-key
api_secret=your-cloudinary-api-secret
